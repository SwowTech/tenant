APP_NAME=swow.tech
APP_ENV=dev
APP_DEBUG=false

DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mineadmin
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=redis
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0

# 对外协议+主机，不要带端口（端口用 SERVER_PORT）
APP_GATEWAY_SECRET=dev-app-gateway-secret

APP_GATEWAY_SECRET=dev-app-gateway-secret

APP_URL=http://127.0.0.1
SERVER_PORT=9501

JWT_SECRET=azOVxsOWt3r0ozZNz8Ss429ht0T8z6OpeIJAIwNp6X0xqrbEY2epfIWyxtC1qSNM8eD6/LQ/SahcQi2ByXa/2A==

MINE_ACCESS_TOKEN=(null) # Your MINE_ACCESS_TOKEN

PLATFORM_DB_DATABASE=platform_db
INTERNAL_API_TOKEN=internal-provision-token-change-me
INTERNAL_ALLOWED_IPS=127.0.0.1,::1

APP_VERSION=1.0.0
SAAS_ADMIN_URL=http://127.0.0.1:5174
# saas-vue base=/platform/，passport 页为 /platform/passport
SAAS_PASSPORT_URL=http://127.0.0.1:5174/platform/passport
# --- Cloud app store (internal app-install, saas store license verify) ---
# saas-php 公网基址（诊断 ping / internal revoke / 系统升级 check / store license verify）
# E2E: saas-php/scripts/test-store-e2e.php 安装段需本机 saas HTTP 可达
SAAS_PHP_PUBLIC_URL=http://127.0.0.1:9502
# 应用包下载 host 白名单（逗号分隔；cloud app-install 校验 package_url）
STORE_PACKAGE_URL_ALLOWLIST=127.0.0.1,localhost
# 与 saas USER_PHP_INTERNAL_TOKEN 一致（X-Internal-Token）
INTERNAL_API_TOKEN=internal-provision-token-change-me
# 与 saas CLOUD_UPGRADE_PUBLIC_TOKEN 一致（saas 未配置则可留空）
# CLOUD_UPGRADE_PUBLIC_TOKEN=

# 前端静态同步目标目录；未配置则升级时跳过 frontend
# CLOUD_UPGRADE_FRONTEND_DIR=
# 升级包体积上限（MB）
CLOUD_UPGRADE_MAX_PACKAGE_MB=200
# UPGRADE_CHECK_URL=
